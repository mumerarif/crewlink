# Local Docker database. Development values only; replace them outside local use.
POSTGRES_DB=crewlink
POSTGRES_USER=crewlink
POSTGRES_PASSWORD=crewlink_dev_password
DATABASE_URL=postgresql://crewlink:crewlink_dev_password@postgres:5432/crewlink?schema=public

# Internal Docker service URLs.
REDIS_URL=redis://redis:6379
INTERNAL_API_URL=http://nginx

# Authentication. Use a secret-manager-generated value in any real deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Safe offline default. Leave the key empty in mock mode or add OpenRouter API Key and use openrouter.
AI_DRAFT_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=15000

# Durable outbox/worker tuning.
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_STALE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5

# Browser/API origin and cookie transport. Set Secure=true only with HTTPS.
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Public Swagger UI for local assessment. Set false in production.
API_DOCS_ENABLED=true
