{
  "name": "@crewlink/api",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/notification.worker.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/run-database-integration.js",
    "test:security": "node tests/run-security-integration.js",
    "test:phase4": "node tests/run-phase4-integration.js",
    "test:phase5": "node tests/run-phase5-integration.js",
    "check": "node --check src/server.js && node --check src/workers/notification.worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.4.1",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-validator": "7.3.2",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "nodemon": "3.1.10",
    "prisma": "6.19.0",
    "supertest": "7.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
